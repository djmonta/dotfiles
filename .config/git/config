[alias]
	l = log
	lg = log --graph
	lk = log --graph --topo-order --abbrev-commit --date=short --decorate --all --boundary --pretty=format:'%Cgreen%ad %Cred%h%Creset -%C(yellow)%d%Creset %s %Cblue[%cn]%Creset'
	lo = log --oneline
	lp = log --patch
	lt = log --topo-order
	branch-list-merged = "!git branch --merged master | grep -v -E '(develop|origin|master)'"
	branch-delete-merged = "!git branch-list-merged | xargs git branch -d"
[user]
	name = monta
	email = djmonta@gmail.com
	signingkey = 51F3E100AC4B30813F9AF72CFA019D34F1DD8BC7
[mergetool]
	keepBackup = true
	prompt = false
[color]
	ui = true
[core]
	excludesfile = ~/.config/git/.gitignore.default
	quotepath = false
[commit]
	template = ~/.config/git/.gittemplate
	gpgsign = true

[credential]
	helper = osxkeychain
[gpg]
	program = /usr/local/MacGPG2/bin/gpg2

[i18n]
	logoutputencoding = utf-8
	commitencoding = utf-8
